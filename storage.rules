rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /couples/{coupleId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && exists(/databases/(default)/documents/couples/$(coupleId))
        && (
          get(/databases/(default)/documents/couples/$(coupleId)).data.partner1_uid == request.auth.uid
          || get(/databases/(default)/documents/couples/$(coupleId)).data.partner2_uid == request.auth.uid
        );
    }
  }
}